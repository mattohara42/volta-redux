; Engine configuration file.
; Generated and maintained by Godot. Hand edits here are fine but the editor
; will re-serialise them.

config_version=5

[application]

config/name="Volta Redux"
config/description="A 2D puzzle platformer. The sword is the game."
run/main_scene="res://scenes/rooms/room_m0.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[physics]

common/physics_ticks_per_second=60
2d/default_gravity=0.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; Palette.BACKDROP. Kept in step by test_palette.gd, because a neutral grey
; letterbox is still a neutral grey and ART_DIRECTION.md does not allow one.
environment/defaults/default_clear_color=Color(0.12941177, 0.10980392, 0.2, 1)

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="ladders"
2d_physics/layer_3="player"
2d_physics/layer_4="swords"
2d_physics/layer_5="sword_ledges"
2d_physics/layer_6="enemies"

