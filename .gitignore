# Godot
.godot/
/android/
/build/
/export/
*.translation
# Regenerated by tools/dev.sh import. M5's art is the first to produce these;
# CI and every session import fresh rather than trusting a committed cache.
*.import

# Screenshots. `tools/dev.sh shot` and the CI steps write these next to the
# project, so a local run of what CI runs leaves a dozen of them in git status.
/*.png

# Python, from tools/scenarios.py importing tools/scenarios_data.py
__pycache__/

# Editor and OS
.DS_Store
*.log

# Claude Code, personal overrides
.claude/settings.local.json
